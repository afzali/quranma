{
	"name": "client",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"dev:electron": "npx cap sync electron && concurrently -k -n vite,electron \"vite dev\" \"wait-on http://localhost:5173 && cross-env NODE_ENV=development npx cap open electron\"",
		"build": "vite build",
		"build:electron": "vite build && npx cap sync electron",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
	},
	"devDependencies": {
		"@capacitor/cli": "^8.3.1",
		"@internationalized/date": "^3.12.1",
		"@lucide/svelte": "^1.14.0",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.57.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@tailwindcss/vite": "^4.2.4",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/svelte": "^5.3.1",
		"bits-ui": "^2.18.1",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"concurrently": "^9.2.1",
		"cross-env": "^10.1.0",
		"embla-carousel-svelte": "^8.6.0",
		"formsnap": "^2.0.1",
		"jsdom": "^29.1.1",
		"layerchart": "^1.0.13",
		"mode-watcher": "^1.1.0",
		"paneforge": "^1.0.2",
		"svelte": "^5.55.2",
		"svelte-check": "^4.4.6",
		"svelte-sonner": "^1.1.1",
		"tailwind-merge": "^3.5.0",
		"tailwind-variants": "^3.2.2",
		"tailwindcss": "^4.2.4",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.2",
		"vaul-svelte": "^0.3.2",
		"vite": "^8.0.7",
		"vitest": "^4.1.5",
		"wait-on": "^9.0.5"
	},
	"dependencies": {
		"@capacitor-community/electron": "^5.0.1",
		"@capacitor-community/sqlite": "^8.1.0",
		"@capacitor/core": "^8.3.1"
	}
}
